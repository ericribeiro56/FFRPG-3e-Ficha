          <span class="grupo-collapse-icon">
            <i class="far fa-minus-square"></i>
            <i class="far fa-plus-square"></i>
          </span>
        </div>
        <div class="sub-tabela-header-row">
          <span style="flex: 3;">Nome</span>
          <span style="flex: 2;">Informações</span>
          <span style="flex: 2; margin-right: 56px;">Habilidade</span>
        </div>
        {{#each weapons}}
