              </div>
            </div>
          </div>
        {{else}}
          <div style="height: 2px;"></div>
        {{/each}}
      </div>

      <div class="inventario-grupo-bloco {{#if gruposVazios.shields}}is-collapsed{{/if}}" data-grupo="shields">
        <div class="inventario-grupo-header" data-action="toggleGroup" data-target="shields">
          <span>Escudos</span>
          <span class="grupo-collapse-icon">
