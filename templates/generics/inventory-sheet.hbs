            </div>
            <div class="inventario-actions-wrapper">
              <div class="inventario-btn-box">
                <button type="button" class="inventario-btn btn-excluir" data-action="removerItemFicha" data-item-id="{{this.id}}" title="Excluir">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
        {{else}}
          <div style="height: 2px;"></div>
        {{/each}}
      </div>

      <div class="inventario-grupo-bloco {{#if gruposVazios.others}}is-collapsed{{/if}}" data-grupo="others">
        <div class="inventario-grupo-header" data-action="toggleGroup" data-target="others">
