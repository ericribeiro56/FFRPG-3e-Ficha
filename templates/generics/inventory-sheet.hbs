                {{this.system.abilityDisplay}}
              </span>
            </div>
            <div class="inventario-actions-wrapper">
              <div class="inventario-btn-box">
                <button type="button" class="inventario-btn btn-equipar" data-action="equiparItem" data-item-id="{{this.id}}" title="Equipar">
                  <i class="fas fa-gavel"></i>
                </button>
              </div>
              <div class="inventario-btn-box">
                <button type="button" class="inventario-btn btn-excluir" data-action="removerItemFicha" data-item-id="{{this.id}}" title="Excluir">
