              <span class="bolso-quantidade">x{{this.system.quantidade}}</span>
            </div>
            <div class="inventario-actions-wrapper">
              <div class="inventario-btn-box">
                <button type="button" class="inventario-btn btn-excluir" data-action="removerItemFicha" data-item-id="{{this.id}}" title="Excluir">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
        {{else}}
          <div style="height: 2px;"></div>
        {{/each}}
      </div>

      <div class="inventario-grupo-bloco {{#if gruposVazios.combat}}is-collapsed{{/if}}" data-grupo="combat">
