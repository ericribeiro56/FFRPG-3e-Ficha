              </div>
            </div>
          </div>
        {{else}}
          <div style="height: 2px;"></div>
        {{/each}}
      </div>

      <div class="inventario-grupo-bloco {{#if gruposVazios.ammo}}is-collapsed{{/if}}" data-grupo="ammo">
        <div class="inventario-grupo-header" data-action="toggleGroup" data-target="ammo">
          <span>Munição</span>
