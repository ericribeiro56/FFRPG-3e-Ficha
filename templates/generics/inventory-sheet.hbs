      <div class="inventario-grupo-bloco {{#if gruposVazios.armor}}is-collapsed{{/if}}" data-grupo="armor">
        <div class="inventario-grupo-header" data-action="toggleGroup" data-target="armor">
          <span>Armaduras</span>
          <span class="grupo-collapse-icon">
            <i class="far fa-minus-square"></i>
            <i class="far fa-plus-square"></i>
          </span>
        </div>
        <div class="sub-tabela-header-row">
          <span style="flex: 1.2;">Slot</span>
          <span style="flex: 2.8;">Nome</span>
          <span style="flex: 2;">Informações</span>
          <span style="flex: 2; margin-right: 56px;">Habilidade</span>
        </div>
        {{#each armor}}
          <div class="inventario-row-item">
            <div class="inventario-item-corpo" data-action="abrirSheetItem" data-item-id="{{this.id}}">
              <span class="tabela-slot">{{traduzirSlot this.system.slot}}</span>
              <span class="tabela-nome">{{this.system.displayName}}</span>
              <span class="tabela-info">{{this.system.combatDisplay}}</span>
              <span class="tabela-habilidade" title="{{this.system.abilityDisplay}}">
