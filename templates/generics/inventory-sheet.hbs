              <div class="inventario-btn-box">
                <button type="button" class="inventario-btn btn-usar" data-action="usarItem" data-item-id="{{this.id}}" title="Arremessar em Combate">
                  <i class="fas fa-bomb"></i>
                </button>
              </div>
              <div class="inventario-btn-box">
                <button type="button" class="inventario-btn btn-excluir" data-action="removerItemFicha" data-item-id="{{this.id}}" title="Excluir">
                  <i class="fas fa-trash"></i>
