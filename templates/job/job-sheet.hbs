
<div class="sheet-container custom-job-sheet-wrapper">

    
    <div class="sheet-header-wrapper">
        <div class="img-wrapper">
            <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
        </div>
        
        <div class="header-fields">
            <div class="field-group name-field">
                <label>Nome do Job / Vocação</label>
                <input name="name" type="text" value="{{item.name}}" placeholder="Ex: Cavaleiro Negro"/>
            </div>
            
            <div class="field-group class-field">
                <label>Classe</label>
                <select name="system.class">
                  {{#each classList}}
                  <option value="{{this.value}}">{{this.label}}</option>
                  {{/each}}
                </select>
            </div>
        </div>
    </div>

    
    <div class="bottom-section">
        <nav class="sheet-tabs tabs" data-group="primary">
            <a class="item" data-tab="principal">Informações</a>
            <a class="item" data-tab="jobSkill">Habilidades</a>
        </nav>

        <section class="sheet-body">

            <!-- ==========================================================================
                 ABA 1: INFORMAÇÕES (PRINCIPAL - ALTA PERFORMANCE HORIZONTAL)
                 ========================================================================== -->
            <div class="tab" data-group="primary" data-tab="principal">
                <div class="main-tab-grid-layout">
                    
                    
                    <div class="column-mechanics-left">
                        <div class="job-progression-rows-stack">
                            
                            
                            <div class="property-block-vertical full-width-row">
                                <span class="block-title-tag">Modificadores de Atributo</span>
                                <div class="attributes-inputs-inner-grid">
                                    <div class="mini-field-group"><label>FOR</label><input type="number" name="system.attribute.strength" value="{{system.attribute.strength}}"/></div>
                                    <div class="mini-field-group"><label>VIT</label><input type="number" name="system.attribute.vitality" value="{{system.attribute.vitality}}"/></div>
                                    <div class="mini-field-group"><label>AGI</label><input type="number" name="system.attribute.agility" value="{{system.attribute.agility}}"/></div>
                                    <div class="mini-field-group"><label>VEL</label><input type="number" name="system.attribute.speed" value="{{system.attribute.speed}}"/></div>
                                    <div class="mini-field-group"><label>MAG</label><input type="number" name="system.attribute.magic" value="{{system.attribute.magic}}"/></div>
                                    <div class="mini-field-group"><label>ESP</label><input type="number" name="system.attribute.spirit" value="{{system.attribute.spirit}}"/></div>
                                </div>
                            </div>

                            
                            <div class="property-block-vertical full-width-row">
                                <span class="block-title-tag">Dados de Crescimento</span>
                                <div class="growth-inputs-inner-grid">
                                    <div class="field-group"><label>Dado HP</label><input type="text" name="system.dice.hp" value="{{system.dice.hp}}" placeholder="1d10"/></div>
                                    <div class="field-group"><label>Dado MP</label><input type="text" name="system.dice.mp" value="{{system.dice.mp}}" placeholder="1d4"/></div>
                                    <div class="field-group"><label>Lim. Proficiência</label><input type="number" name="system.proficiency.limit" value="{{system.proficiency.limit}}"/></div>
                                </div>
                            </div>
                        </div>

                        
                        <div class="properties-section-grid main-tab-equip-2x2-grid">
                            
                            
                            <div class="property-block-vertical prof-compensated-height-block">
                                <span class="block-title-tag">Bônus de Proficiência</span>
                                <div class="block-adder-triple-row">
                                    <select class="add-prof-key">
                                        {{#each proficiencyOptions}}<option value="{{this.value}}">{{this.label}}</option>{{/each}}
                                    </select>
                                    <input type="number" class="add-prof-value" placeholder="0"/>
                                    <button type="button" class="action-btn-add" data-action="addProficiencyBonus">+</button>
                                </div>
                                <div class="vertical-scroll-list prof-compensated-scroll">
                                    {{#each system.proficiency.bonus as |bonus index|}}
                                    <div class="list-item-row proficiency">
                                        <span class="item-text-content"><strong>{{proficiencyDisplay bonus.key}}</strong>: +{{bonus.value}}</span>
                                        <button type="button" class="action-btn-remove" data-action="removeProficiencyBonus" data-index="{{index}}">×</button>
                                    </div>
                                    {{/each}}
                                </div>
                            </div>

                            
                            <div class="property-block-vertical prof-compensated-height-block">
                                <div class="precision-header-input">
                                    <label>Precisão</label>
                                    <input type="number" name="system.accuracyBonus" value="{{system.accuracyBonus}}"/>
                                </div>
                                <span class="block-title-tag">Armas Permitidas</span>
                                <div class="block-adder-row">
                                    <select class="add-weapon-select">
                                        {{#each weaponOptions}}<option value="{{this.value}}">{{this.label}}</option>{{/each}}
                                    </select>
                                    <button type="button" class="action-btn-add" data-action="addAllowedWeapon">+</button>
                                </div>
                                <div class="vertical-scroll-list height-104-scroll">
                                    {{#each system.mainWeapons as |weapon index|}}
                                    <div class="list-item-row"><span class="item-text-content">{{weapon}}</span><button type="button" class="action-btn-remove" data-action="removeAllowedWeapon" data-index="{{index}}">×</button></div>
                                    {{/each}}
                                </div>
                            </div>

                            
                            <div class="property-block-vertical compact-row-height-block">
                                <span class="block-title-tag">Tags do Job</span>
                                <div class="block-adder-row">
                                    <input type="text" class="add-job-tag-input" placeholder="Nova tag..."/>
                                    <button type="button" class="action-btn-add" data-action="addJobTag">+</button>
                                </div>
                                <div class="vertical-scroll-list compact-height-scroll">
                                    {{#each system.tags as |tag index|}}
                                    <div class="list-item-row"><span class="item-text-content">{{tag}}</span><button type="button" class="action-btn-remove" data-action="removeJobTag" data-index="{{index}}">×</button></div>
                                    {{/each}}
                                </div>
                            </div>

                            
                            <div class="property-block-vertical compact-row-height-block">
                                <span class="block-title-tag">Armaduras Permitidas</span>
                                <div class="block-adder-row">
                                    <select class="add-armor-select">
                                        {{#each armorOptions}}<option value="{{this.value}}">{{this.label}}</option>{{/each}}
                                    </select>
                                    <button type="button" class="action-btn-add" data-action="addAllowedArmor">+</button>
                                </div>
                                <div class="vertical-scroll-list compact-height-scroll">
                                    {{#each system.allowedArmors as |armor index|}}
                                    <div class="list-item-row"><span class="item-text-content">{{armor}}</span><button type="button" class="action-btn-remove" data-action="removeAllowedArmor" data-index="{{index}}">×</button></div>
                                    {{/each}}
                                </div>
                            </div>
                        </div>
                    </div>

                    
                    <div class="column-lore-right" style="height: 585px !important;">
                        <div class="field-group job-narrative-box">
                            <label>Descrição / Lore do Job</label>
                            <div class="editor-content-wrapper-box"><prose-mirror name="system.description" value="{{system.description}}" class="prose-mirror-style">{{{descricaoEnriquecida}}}</prose-mirror></div>
                        </div>
                        <div class="field-group job-narrative-box">
                            <label>Notas do Mestre</label>
                            <div class="editor-content-wrapper-box"><prose-mirror name="system.notes" value="{{system.notes}}" class="prose-mirror-style">{{{notasEnriquecidas}}}</prose-mirror></div>
                        </div>
                    </div>

                </div>
            </div> 

            <!-- ==========================================================================
                 ABA 2: HABILIDADES (JOBSKILL - BANDEJA TOTALMENTE INTEGRADA)
                 ========================================================================== -->
            <div class="tab" data-group="primary" data-tab="jobSkill">
                <div class="skills-tab-layout">
                    
                    
                    <div class="skills-sidebar">
                        <button type="button" class="add-new-skill-btn" data-action="addNewJobSkill">+ Add Skill</button>
                        <div class="skills-scroll">
                            {{#each system.skills as |skill index|}}
                            <div class="sidebar-skill-item {{#if (eq ../activeSkillIndex index)}}selected{{/if}}" data-action="selectJobSkill" data-index="{{index}}">
                                <span class="nav-skill-name-text">{{#if skill.name}}{{skill.name}}{{else}}Nova Skill{{/if}}</span>
                                <button type="button" class="delete-skill-icon-btn" data-action="deleteJobSkill" data-index="{{index}}" title="Excluir Habilidade">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                            {{/each}}
                        </div>
                    </div>

                    
                    <div class="skill-detail-panel">
                        {{#if tempSkill}}
                            <div class="container-detalhe unique-tray-envelope">
                                
                                <div class="tray-columns-wrapper-horizontal">
                                    
                                    <div class="col-detalhe-esq transparent-inner-blocks">
                                        
                                        
                                        <div class="property-block-vertical-skill-tray">
                                            <div class="skill-linear-identification-grid">
                                                <div class="field-group inline-flex-item-grow"><label>Nome</label><input type="text" name="system.skills.{{activeSkillIndex}}.name" value="{{tempSkill.name}}"/></div>
                                                <div class="field-group inline-flex-item-fixed-niv"><label>Nív</label><input type="number" name="system.skills.{{activeSkillIndex}}.minLevel" value="{{tempSkill.minLevel}}"/></div>
                                                <div class="field-group inline-flex-item-fixed-tipo"><label>Tipo</label>
                                                    <select name="system.skills.{{activeSkillIndex}}.type">
                                                        <option value="active" {{#if (eq tempSkill.type "active")}}selected{{/if}}>Ativa</option>
                                                        <option value="support" {{#if (eq tempSkill.type "support")}}selected{{/if}}>Suporte</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        
                                        <div class="skill-cost-container-row-block">
                                            <span class="panel-inside-title">Custo da Habilidade</span>
                                            <div class="skill-linear-cost-grid">
                                                <div class="field-group" style="flex: 1.5;"><select name="system.skills.{{activeSkillIndex}}.cost.type">
                                                    <option value="mp" {{#if (eq tempSkill.cost.type "mp")}}selected{{/if}}>Mana (MP)</option>
                                                    <option value="hp" {{#if (eq tempSkill.cost.type "hp")}}selected{{/if}}>Vida (HP)</option>
                                                    <option value="material" {{#if (eq tempSkill.cost.type "material")}}selected{{/if}}>Material</option>
                                                    <option value="nothing" {{#if (eq tempSkill.cost.type "nothing")}}selected{{/if}}>Sem Custo</option>
                                                </select></div>
                                                <div class="field-group" style="flex: 3;"><input type="text" name="system.skills.{{activeSkillIndex}}.cost.material" value="{{tempSkill.cost.material}}" placeholder="Objeto (Material)"/></div>
                                                <div class="field-group" style="flex: 1;"><input type="number" name="system.skills.{{activeSkillIndex}}.cost.value" value="{{tempSkill.cost.value}}" placeholder="Valor"/></div>
                                            </div>
                                        </div>

                                        
                                        <div class="skill-checks-container-row-block">
                                            <span class="panel-inside-title">Regras Adicionais de Aplicação</span>
                                            <div class="skill-double-line-checks-layout">
                                                <div class="checks-row-line">
                                                    <div class="row-inline-check"><input type="checkbox" name="system.skills.{{activeSkillIndex}}.support" {{#if tempSkill.support}}checked{{/if}} id="skill-sup-{{activeSkillIndex}}"/> <label for="skill-sup-{{activeSkillIndex}}">Suporte</label></div>
                                                    <div class="row-inline-check"><input type="checkbox" name="system.skills.{{activeSkillIndex}}.combat.ally" {{#if tempSkill.combat.ally}}checked{{/if}} id="skill-ally-{{activeSkillIndex}}"/> <label for="skill-ally-{{activeSkillIndex}}">Afeta Aliados</label></div>
                                                </div>
                                                <div class="checks-row-line margin-top-6">
                                                    <div class="row-inline-check"><input type="checkbox" name="system.skills.{{activeSkillIndex}}.combat.area" {{#if tempSkill.combat.area}}checked{{/if}} id="skill-area-{{activeSkillIndex}}"/> <label for="skill-area-{{activeSkillIndex}}">Área</label></div>
                                                    <div class="field-group inline-range-box-wrapper" style="display: contents;"><label>Alcance</label><input type="text" name="system.skills.{{activeSkillIndex}}.combat.range" value="{{tempSkill.combat.range}}" placeholder="Ex: 10m" style="width: 80px !important;"/></div>
                                                </div>
                                            </div>
                                        </div>

                                        
                                        <div class="skill-footer-split-grid">
                                            <div class="inner-tray-sub-dark-box">
                                                <span class="block-title-tag">Mecânica de Combate</span>
                                                <div class="input-and-button-row">
                                                    <input type="text" class="temp-combat-formula" placeholder="Ex: 2d6 + FOR"/>
                                                    <button type="button" class="action-btn-add inner-fixed-add" data-action="addValidatedFormula" data-skill-index="{{activeSkillIndex}}" {{#if tempSkill.combat.formula}}disabled{{/if}}>+</button>
                                                </div>
                                                <div class="validated-formula-box">
                                                    {{#if tempSkill.combat.formula}}
                                                        <span class="formula-text">{{tempSkill.combat.formula}}</span>
                                                        <button type="button" data-action="removeValidatedFormula" data-skill-index="{{activeSkillIndex}}">×</button>
                                                    {{else}}
                                                        <span style="font-size:11px; opacity:0.3; font-style:italic">Nenhuma fórmula.</span>
                                                    {{/if}}
                                                </div>
                                            </div>

                                            <div class="inner-tray-sub-dark-box">
                                                <span class="block-title-tag">Tags da Skill</span>
                                                <div class="input-and-button-row">
                                                    <input type="text" class="add-skill-tag-input" placeholder="Nova tag..."/>
                                                    <button type="button" class="action-btn-add inner-fixed-add" data-action="addSkillTag" data-skill-index="{{activeSkillIndex}}">+</button>
                                                </div>
                                                <div class="vertical-scroll-list" style="height:46px !important; flex-direction:row; flex-wrap:wrap; align-content:flex-start;">
                                                    {{#each tempSkill.tags as |tag tIdx|}}
                                                        <div class="list-item-row compact-badge skill-badge-color" style="margin-bottom:2px">
                                                            <span class="item-text-content">{{tag}}</span>
                                                            <button type="button" class="action-btn-remove" data-action="removeSkillTag" data-skill-index="{{../activeSkillIndex}}" data-tag-index="{{tIdx}}">×</button>
                                                        </div>
                                                    {{/each}}
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    
                                    <div class="col-detalhe-dir transparent-inner-blocks">
                                        <div class="field-group job-narrative-box">
                                            <label>Descrição Detalhada da Skill</label>
                                            <div class="editor-content-wrapper-box"><prose-mirror name="system.skills.{{activeSkillIndex}}.description" data-target="system.skills.{{activeSkillIndex}}.description" value="{{tempSkill.description}}" class="prose-mirror-style">{{{tempSkillDescriptionEnriched}}}</prose-mirror></div>
                                        </div>
                                        <div class="field-group job-narrative-box">
                                            <label>Notas e Restrições Técnicas</label>
                                            <div class="editor-content-wrapper-box"><prose-mirror name="system.skills.{{activeSkillIndex}}.notes" data-target="system.skills.{{activeSkillIndex}}.notes" value="{{tempSkill.notes}}" class="prose-mirror-style">{{{tempSkillNotesEnriched}}}</prose-mirror></div>
                                        </div>
                                    </div>
                                </div>

                                
                                <div class="tray-footer-save-button-row">
                                    <button type="button" class="action-btn-save-skill-tray" data-action="saveSkillTrayChanges">
                                        <i class="fas fa-save"></i> Salvar
                                    </button>
                                    <button type="button" class="action-btn-close-skill-tray" data-action="closeSkillTray">
                                        <i class="fas fa-times"></i> Fechar
                                    </button>
                                </div>

                            </div>
                        {{else}}
                            <div class="select-skill-prompt-notice"><div><p>Nenhuma habilidade selecionada.</p><span>Clique em uma skill no menu lateral para abrir o painel de detalhes.</span></div></div>
                        {{/if}}
                    </div>
                </div>
            </div> 

        </section>
    </div>
</div>
