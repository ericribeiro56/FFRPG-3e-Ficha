<div class="job-skill-wrapper">
    <div class="job-skill-lista">
        {{#each skillsFiltradas}}
            <div class="extrato-item" data-action="openSkillDetail" data-index="{{this.index}}">
                <div class="status-barra"></div>
                <div class="extrato-corpo">
                    <div class="linha-principal">
                        <span class="badge-acao">{{this.name}}</span>
                        <span class="valor-gil">Nív {{this.minLevel}}</span>
                    </div>
                    <div class="linha-descricao">
                        <span>Tipo: {{this.typeLabel}}</span>
                    </div>
                </div>
            </div>
        {{else}}
            <div class="extrato-vazio">
                <i class="fas fa-folder-open"></i>
                <p>Nenhuma habilidade disponível para o nível atual.</p>
            </div>
        {{/each}}
    </div>

    {{#if selectedSkill}}
    <div class="job-skill-detalhe">
        <div class="extrato-wrapper">
            <div class="extrato-cabecalho">
                <h3><i class="fas fa-book-open"></i> {{selectedSkill.name}}</h3>
            </div>

            <div class="job-skill-detalhe-conteudo">
                <div class="linha-info">
                    <label>Tipo:</label>
                    <span>{{selectedSkill.typeLabel}}</span>
                </div>
                <div class="linha-info">
                    <label>Nível Mínimo:</label>
                    <span>{{selectedSkill.minLevel}}</span>
                </div>
                <div class="linha-info">
                    <label>Suporte:</label>
                    <span>{{#if selectedSkill.support}}Sim{{else}}Não{{/if}}</span>
                </div>

                <div class="linha-info">
                    <label>Custo:</label>
                    <span>
                        {{#if (eq selectedSkill.cost.type "mp")}}MP: {{selectedSkill.cost.value}}{{/if}}
                        {{#if (eq selectedSkill.cost.type "hp")}}HP: {{selectedSkill.cost.value}}{{/if}}
                        {{#if (eq selectedSkill.cost.type "material")}}{{selectedSkill.cost.material}} ({{selectedSkill.cost.value}}){{/if}}
                        {{#if (eq selectedSkill.cost.type "nothing")}}Sem Custo{{/if}}
                    </span>
                </div>

                {{#if selectedSkill.combat.formula}}
                <div class="linha-info">
                    <label>Fórmula:</label>
                    <span>{{selectedSkill.combat.formula}}</span>
                </div>
                {{/if}}

                <div class="linha-info">
                    <label>Área:</label>
                    <span>{{#if selectedSkill.combat.area}}Sim{{else}}Não{{/if}}</span>
                </div>
                <div class="linha-info">
                    <label>Afeta Aliados:</label>
                    <span>{{#if selectedSkill.combat.ally}}Sim{{else}}Não{{/if}}</span>
                </div>
                {{#if selectedSkill.combat.range}}
                <div class="linha-info">
                    <label>Alcance:</label>
                    <span>{{selectedSkill.combat.range}}</span>
                </div>
                {{/if}}

                {{#if selectedSkill.tags.length}}
                <div class="linha-info">
                    <label>Tags:</label>
                    <span>{{#each selectedSkill.tags}}{{this}} {{/each}}</span>
                </div>
                {{/if}}

                <div class="linha-info">
                    <label>Descrição:</label>
                    <div class="readonly-prose">{{selectedSkill.descriptionEnriched}}</div>
                </div>

                <div class="linha-info">
                    <label>Notas:</label>
                    <div class="readonly-prose">{{selectedSkill.notesEnriched}}</div>
                </div>
            </div>
        </div>
    </div>
    {{else}}
    <div class="job-skill-detalhe">
        <div class="extrato-vazio" style="height:100%; display:flex; flex-direction:column; justify-content:center; align-items:center;">
            <i class="fas fa-hand-pointer"></i>
            <p>Selecione uma habilidade para ver os detalhes.</p>
        </div>
    </div>
    {{/if}}
</div>
