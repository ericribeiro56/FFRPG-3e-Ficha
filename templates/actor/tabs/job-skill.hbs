<!-- BLOCO 1 DE 2: templates/job-skills.hbs -->
<div class="aba-skills-viewport">
    <div class="skills-master-detail-control">

        <!-- COLUNA ESQUERDA: LISTAGEM DE CARDS (1fr) -->
        <aside class="skills-sidebar-container">
            {{#each skills as |skill index|}}
            <div class="skill-card-item {{skill.type}} {{#if (eq ../_selectedSkillIndex index)}}selected{{/if}}"
                data-action="openSkillDetail" data-index="{{index}}">
                <div class="skill-type-indicator"></div>
                <span class="skill-name">{{skill.name}}</span>
            </div>
            {{/each}}
        </aside>
        <!-- BLOCO 2 DE 2: templates/job-skills.hbs -->
        <!-- COLUNA DIREITA: PALCO CENTRALIZADOR (3fr) -->
        <main class="skill-stage-right">
            {{#if currentSkill}}
            <div class="skill-unique-tray-envelope">

                <!-- REQUERIMENTO -->
                <section class="tray-field-group">
                    <h3 class="tray-label-header">Requerimento</h3>
                    <div class="tray-inline-row">
                        <span><strong>Custo:</strong> {{currentSkill.cost.type}}</span>
                        {{#if (eq currentSkill.cost.type "material")}}
                        <span><strong>Objeto:</strong> {{currentSkill.cost.material}}</span>
                        {{/if}}
                        {{#unless (eq currentSkill.cost.type "nothing")}}
                        <span><strong>Valor:</strong> {{currentSkill.cost.value}}</span>
                        {{/unless}}
                    </div>
                </section>

                <!-- MECÂNICAS EM LINHAS -->
                <section class="tray-field-group">
                    <div class="tray-bool-line"><strong>Suporte:</strong> {{#if
                        currentSkill.support}}Sim{{else}}Não{{/if}}</div>
                    <div class="tray-bool-line"><strong>Afeta Aliados:</strong> {{#if
                        currentSkill.combat.ally}}Sim{{else}}Não{{/if}}</div>
                    <div class="tray-bool-line">
                        <strong>Em Área:</strong> {{#if currentSkill.combat.area}}Sim{{else}}Não{{/if}}
                        {{#if currentSkill.combat.area}}
                        <span class="tray-alcance-badge">Alcance: {{currentSkill.combat.range}}</span>
                        {{/if}}
                    </div>
                </section>

                <!-- COMBATE -->
                <section class="tray-field-group">
                    <div class="tray-formula-box">
                        <span class="formula-label">Fórmula:</span>
                        <span class="formula-text">{{currentSkill.combat.formula}}</span>
                        <button type="button" class="tray-roll-btn" data-action="rollSkillFormula"
                            data-index="{{_selectedSkillIndex}}">
                            <i class="fas fa-dice-d20"></i>
                        </button>
                    </div>
                </section>

                <!-- TAGS -->
                <section class="tray-field-group">
                    <div class="tray-tags-line">
                        <strong>Tags:</strong>
                        {{#each currentSkill.tags}}
                        <span class="tag-bracket">[{{this}}]</span>{{#unless @last}}, {{/unless}}
                        {{/each}}
                    </div>
                </section>

                <!-- TEXTOS (DESCRIÇÃO E NOTAS) -->
                <section class="tray-field-group tray-scrollable-texts">
                    <label class="tray-label-header">Descrição</label>
                    <!-- Substituído por div com classes nativas do Foundry para manter a formatação -->
                    <div class="tray-prose-view journal-page-content prose-mirror">
                        {{{enrichedDescription}}}
                    </div>

                    <label class="tray-label-header" style="margin-top: 10px;">Notas</label>
                    <!-- Substituído por div com classes nativas do Foundry para manter a formatação -->
                    <div class="tray-prose-view journal-page-content prose-mirror">
                        {{{enrichedNotes}}}
                    </div>
                </section>

                <!-- RODAPÉ -->
                <footer class="tray-footer">
                    <button type="button" class="tray-close-btn" data-action="closeSkillDetail" data-index="-1">Fechar</button>
                </footer>

            </div>
            {{else}}
            <div class="select-skill-prompt-notice">
                <div>
                    <p style="font-size: 14px; font-weight: bold; color: #8a2be2; margin-bottom: 4px;">Nenhuma
                        habilidade selecionada.</p>
                    <span style="font-size: 12px; opacity: 0.5; color: #444;">Clique em um card de skill no menu lateral
                        para abrir o painel de visualização.</span>
                </div>
            </div>
            {{/if}}
        </main>
    </div>
</div>