<div class="generic-info-wrapper">
    
    <!-- COLUNA ESQUERDA: EXTRATO FINANCEIRO DE GIL (30%) -->
    <div class="generic-info-coluna-financas">
        <div class="extrato-cabecalho">
            <h3><i class="fas fa-history"></i> Histórico de Gil</h3>
        </div>
        
        <ul class="extrato-lista">
            {{#each system.extract_gil}}
                <li class="extrato-item card-{{this.acao}}">
                    <div class="extrato-corpo">
                        <div class="linha-principal">
                            <span class="badge-acao acao-{{this.acao}}">{{this.acao}}</span>
                            <span class="valor-gil">{{this.valor}} <small>GIL</small></span>
                        </div>
                        
                        {{#if this.descricao}}
                            <div class="linha-descricao">
                                <i class="fas fa-comment-alt"></i> <span>{{this.descricao}}</span>
                            </div>
                        {{/if}}
                    </div>
                    
                    <div class="extrato-meta">
                        <div class="meta-autor"><i class="fas fa-user-shield"></i> {{this.autor}}</div>
                        <div class="meta-data"><i class="fas fa-clock"></i> {{this.data}}</div>
                    </div>
                </li>
            {{else}}
                <div class="extrato-vazio">
                    <i class="fas fa-folder-open"></i>
                    <p>Nenhuma transação financeira registrada.</p>
                </div>
            {{/each}}
        </ul>
    </div>

    <!-- COLUNA DIREITA: GRID INTERNO SUBDIVIDIDO (70%) -->
    <div class="generic-info-coluna-cronicas">
        
        <!-- Linha do Topo da Direita: História e Personalidade Lado a Lado -->
        <div class="cronicas-linha-topo">
            
            <!-- Bloco: História -->
            <div class="cronica-bloco">
                <div class="cronica-cabecalho">
                    <h4><i class="fas fa-book-open"></i> História do Personagem</h4>
                </div>
                <div class="cronica-editor">
                    <prose-mirror name="system.info.backstory" 
                                  data-target="system.info.backstory" 
                                  value="{{system.info.backstory}}"
                                  class="prose-mirror-style">
                        {{{enrichBackstory}}}
                    </prose-mirror>
                </div>
            </div>

            <!-- Bloco: Personalidade -->
            <div class="cronica-bloco">
                <div class="cronica-cabecalho">
                    <h4><i class="fas fa-user-tag"></i> Personalidade</h4>
                </div>
                <div class="cronica-editor">
                    <prose-mirror name="system.info.personality" 
                                  data-target="system.info.personality" 
                                  value="{{system.info.personality}}"
                                  class="prose-mirror-style">
                        {{{enrichPersonality}}}
                    </prose-mirror>
                </div>
            </div>

        </div>

        <!-- Linha da Base da Direita: Notas Ocupando as 2 Colunas -->
        <div class="cronicas-linha-base">
            <div class="cronica-bloco">
                <div class="cronica-cabecalho">
                    <h4><i class="fas fa-sticky-note"></i> Notas da Aventura</h4>
                </div>
                <div class="cronica-editor">
                    <prose-mirror name="system.info.notes" 
                                  data-target="system.info.notes" 
                                  value="{{system.info.notes}}"
                                  class="prose-mirror-style">
                        {{{enrichNotes}}}
                    </prose-mirror>
                </div>
            </div>
        </div>

    </div>

</div>
